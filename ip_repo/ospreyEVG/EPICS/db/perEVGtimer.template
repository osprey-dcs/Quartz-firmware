record(longout, "$(P)TMR:$(N):event") {
    field(DESC, "Event generator timer $(N) event code")
    field(DTYP, "FEED Register Write")
    field(OUT , "@name=$(PORT) reg=EVG:tmr$(N):event")
    field(LOPR, "0")
    field(HOPR, "255")
    field(DRVL, "0")
    field(DRVH, "255")
}
record(longout, "$(P)TMR:$(N):divisor") {
    field(DESC, "Event generator timer $(N) clock divisor")
    field(DTYP, "FEED Register Write")
    field(OUT , "@name=$(PORT) reg=EVG:tmr$(N):divisor")
}
